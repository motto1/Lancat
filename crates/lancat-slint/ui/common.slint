// 共用：主题 token（src/styles/global.css）、软件渲染补丁（Fx：阴影图 / 旋转路径 / 虚线 / 合成层）、
// 线条图标、图标按钮、提示气泡、设置页按钮。

export global Theme {
    in-out property <bool> dark: false;
    // Windows（Acrylic）/ macOS 有原生材质：CSS tint 更淡；Linux 没有（main.rs 设 false）
    in-out property <bool> native-glass: true;
    in-out property <color> accent: #0a84ff;
    out property <color> accent-contrast: #ffffff;
    out property <color> glass: native-glass
        ? (dark ? rgba(30, 30, 34, 0.38) : rgba(246, 246, 248, 0.42))
        : (dark ? rgba(36, 36, 40, 0.82) : rgba(246, 246, 248, 0.86));
    out property <color> glass-strong: dark ? rgba(44, 44, 48, 0.94) : rgba(252, 252, 253, 0.94);
    // 不透明版本：只用在「描边里套描边」这类 CSS 也是不透明观感的小地方
    out property <color> glass-strong-solid: dark ? #2c2c30 : #fcfcfd;
    out property <color> glass-border: dark ? rgba(255, 255, 255, 0.12) : rgba(0, 0, 0, 0.1);
    out property <color> glass-highlight: dark ? rgba(255, 255, 255, 0.14) : rgba(255, 255, 255, 0.75);
    out property <color> sidebar: dark ? rgba(255, 255, 255, 0.04) : rgba(0, 0, 0, 0.035);
    out property <color> text: dark ? #f5f5f7 : #1d1d1f;
    out property <color> text-2: dark ? rgba(235, 235, 245, 0.68) : rgba(60, 60, 67, 0.72);
    out property <color> text-3: dark ? rgba(235, 235, 245, 0.38) : rgba(60, 60, 67, 0.45);
    out property <color> sep: dark ? rgba(255, 255, 255, 0.09) : rgba(0, 0, 0, 0.08);
    out property <color> bubble-in: dark ? rgba(255, 255, 255, 0.1) : rgba(0, 0, 0, 0.06);
    out property <color> hover: dark ? rgba(255, 255, 255, 0.07) : rgba(0, 0, 0, 0.05);
    out property <color> field: dark ? rgba(255, 255, 255, 0.07) : rgba(255, 255, 255, 0.7);
    out property <color> seg-on: dark ? rgba(255, 255, 255, 0.17) : glass-strong;
    out property <color> rim-top: dark ? rgba(255, 255, 255, 0.22) : rgba(255, 255, 255, 0.85);
    out property <color> online: #30d158;
    out property <color> danger: #ff3b30;
    out property <color> warn: #ff9f0a;
    out property <duration> dur-fast: 120ms;
    out property <duration> dur: 160ms;
    out property <duration> dur-slow: 220ms;
    // color-mix(in srgb, a, b p%)
    public pure function mix(a: color, b: color, p: float) -> color {
        return a.mix(b, 1 - p);
    }
}

/// 软件渲染器做不到的效果，由 Rust（src/fx.rs）补上。
export global Fx {
    in-out property <float> dpr: 1;
    /// CSS 0.5px 细线：浏览器把不足 1 设备像素的边框画成 1 设备像素。Windows 保持量好的 0.5px，Linux 设为 1 物理像素（src/fx.rs）
    in-out property <length> hair: 0.5px;
    /// 细线边框在布局里占的宽：Windows 0（按 1.5x 截图量好的数值里已含），Linux = 1 物理像素（WebKitGTK 把 0.5px 边框取整成 1 设备像素并计入盒子）
    in-out property <length> hair-box: 0px;
    /// Linux：旧版是 WebKitGTK（原生表单控件走 RenderThemeAdwaita）
    in-out property <bool> gtk;
    /// 默认字体族（Linux 由 src/metrics.rs 按旧版 WebKitGTK 的选择改写）
    in-out property <string> font: "Segoe UI Variable Text";
    // 合成：0 = 普通单遍渲染；1 = 只画基底（活动层隐藏）；n ≥ 2 = 只画第 n 层（src/compose.rs）
    in-out property <int> pass: 0;
    in-out property <bool> a2;
    in-out property <bool> a3;
    in-out property <bool> a4;
    in-out property <bool> a5;
    in-out property <bool> a6;
    in-out property <bool> a7;
    in-out property <bool> a8;
    in-out property <bool> a9;
    /// box-shadow 图（只画在元素外部的外阴影 + 元素内部的 inset 阴影）；kind 见 fx.rs
    pure callback shadow(string, length, length, length, color, bool, float) -> image;
    pure callback shadow-margin(string) -> length;
    /// 24×24 图标路径绕 (12,12) 旋转 deg 度（软件渲染器不支持 rotate）
    pure callback rotate-path(string, float) -> string;
    /// 圆角矩形虚线（CSS dashed）的路径，坐标单位 = 逻辑 px
    pure callback dash-rect(length, length, length, float) -> string;
    /// 自定义填充图（径向渐变高光、Windows 玻璃的 sheen/rim……）
    pure callback paint(string, length, length, color, bool, float) -> image;
    /// 旧版 line-height: normal 的行框高度（字号、内容、Windows 上量好的值）：Linux 按 WebKitGTK 的字体回退与取整算（src/metrics.rs）
    pure callback lb(length, string, length) -> length;
    /// 旧版数字 line-height（如 1.38）的行高：Chromium = 字号×系数；WebKitGTK = 取整字号×系数后截断为整数（src/metrics.rs）
    pure callback lh(length, float) -> length;
    /// 命名缓动曲线 y(x)（cubic-bezier 精确求解）
    pure callback ease(string, float) -> float;

    public pure function base() -> bool {
        return pass <= 1;
    }
    public pure function layer(id: int) -> bool {
        return pass == 0 || pass == id || (pass == 1 && !act(id));
    }
    public pure function act(id: int) -> bool {
        return (id == 2 && a2) || (id == 3 && a3) || (id == 4 && a4) || (id == 5 && a5) || (id == 6 && a6) || (id == 7 && a7) || (id == 8 && a8) || (id == 9 && a9);
    }
}

/// 元素的 box-shadow：放进元素里当第一个子元素（外阴影在元素外、inset 在元素内，互不遮挡）
export component Shadow inherits Image {
    in property <string> kind;
    in property <length> ew;
    in property <length> eh;
    in property <length> r;
    in property <color> c: transparent;
    property <length> m: Fx.shadow-margin(kind);
    x: -m;
    y: -m;
    width: ew + 2 * m;
    height: eh + 2 * m;
    image-fit: fill;
    source: (ew > 0 && eh > 0) ? Fx.shadow(kind, ew, eh, r, c, Theme.dark, Fx.dpr) : @image-url("");
}

/// 浏览器 title 提示（软件渲染下没有原生 tooltip）：悬停 600 ms 后出现在指针下方
export global Tip {
    in-out property <string> text;
    in-out property <length> x;
    in-out property <length> y;
    in-out property <bool> pending;
    in-out property <bool> shown;
    in-out property <int> owner;
    in-out property <int> seq;
    /// 按下过的提示：浏览器点一下就收起 title 提示，直到指针离开那个元素才会再出现。
    /// 点击常常让元素重建（侧栏选中 → 模型刷新），新元素的 has-hover 会再触发一次，所以按文字记。
    in-out property <string> blocked;
    /// 主人元素的矩形（窗口坐标）
    in-out property <length> rx;
    in-out property <length> ry;
    in-out property <length> rw;
    in-out property <length> rh;
    /// Rust（main.rs tip_valid）：指针（平台层记录的真实位置）还在这个矩形里吗
    callback valid(length, length, length, length) -> bool;
    /// Linux：旧版是 WebKitGTK，title 提示是 GTK 原生 tooltip（GTK 主题的样式、500 ms、按下带提示的元素后
    /// 直到指针离开窗口都不再出现）。src/fx.rs 在 Linux 上打开。
    in-out property <bool> gtk;
    in-out property <bool> block-all;
    in-out property <string> gtk-font: "Sans";
    in-out property <length> gtk-size: 13.33px;
    /// GTK 主题 tooltip 的颜色（Breeze：rgba(0,0,0,.8) 底、白 10% 细边、白字；按主题文件读，读不到用 Breeze）
    in-out property <color> gtk-bg: rgba(0, 0, 0, 0.8);
    in-out property <color> gtk-border: rgba(255, 255, 255, 0.1);
    in-out property <color> gtk-fg: #ffffff;
    /// pango 的行高（字体 ascent/descent 向上取整，行内有中文时按回退字体撑高）
    pure callback gtk-line(string) -> length;
}

export component TipArea inherits TouchArea {
    in property <string> tip;
    property <int> me: 0;
    changed has-hover => {
        if self.has-hover && root.tip != "" {
            Tip.seq += 1;
            root.me = Tip.seq;
            Tip.owner = root.me;
            Tip.text = root.tip;
            Tip.x = self.absolute-position.x + self.mouse-x;
            Tip.y = self.absolute-position.y + self.mouse-y;
            Tip.rx = self.absolute-position.x;
            Tip.ry = self.absolute-position.y;
            Tip.rw = self.width;
            Tip.rh = self.height;
            Tip.shown = false;
            if root.tip != Tip.blocked && !Tip.block-all {
                Tip.blocked = "";
                Tip.pending = true;
            } else {
                Tip.pending = false;
            }
        } else if Tip.owner == root.me {
            // 真正离开（不是被重建掉）：解除按下后的屏蔽
            Tip.pending = false;
            Tip.shown = false;
            Tip.blocked = "";
        }
    }
    changed pressed => {
        if self.pressed && root.tip != "" {
            Tip.blocked = root.tip;
            if Tip.gtk { Tip.block-all = true; }
        }
        if Tip.owner == root.me {
            Tip.pending = false;
            Tip.shown = false;
        }
    }
    // 提示出现在指针最后停下的地方（moved 只在按着时触发，悬停移动要看 mouse-x/y）
    changed mouse-x => {
        if Tip.owner == root.me && !Tip.shown && self.has-hover {
            Tip.x = self.absolute-position.x + self.mouse-x;
        }
    }
    changed mouse-y => {
        if Tip.owner == root.me && !Tip.shown && self.has-hover {
            Tip.y = self.absolute-position.y + self.mouse-y;
        }
    }
}

/// 提示气泡本体：放在窗口最上层
export component TipBubble inherits Rectangle {
    in property <length> win-w;
    in property <length> win-h;
    visible: Tip.shown && Tip.text != "";
    // Windows（WebView2 的系统 tooltip）
    property <length> bw: Tip.gtk ? gt.preferred-width + 2 * (12px + 1px) : min(tt.preferred-width + 16px, win-w - 8px);
    property <length> gl: Tip.gtk-line(Tip.text);
    property <int> glines: max(1, round(gt.preferred-height / max(1px, gl)));
    property <length> bh: Tip.gtk ? glines * gl + 2 * (13px + 1px) : tt.preferred-height + 8px;
    // GTK：居中在指针下方 20px，超出输出边时贴边滑动（xdg_popup slide）
    x: Tip.gtk ? clamp(Tip.x - bw / 2, 0px, max(0px, win-w - bw)) : max(4px, min(Tip.x, win-w - bw - 4px));
    y: Tip.gtk ? (Tip.y + 20px + bh > win-h - 7px ? max(7px, Tip.y - bh - 4px) : Tip.y + 20px) : (Tip.y + 20px + bh > win-h - 4px ? max(4px, Tip.y - bh - 6px) : Tip.y + 20px);
    width: bw;
    height: bh;
    border-radius: Tip.gtk ? 5px : 4px;
    background: Tip.gtk ? Tip.gtk-border : (Theme.dark ? #2b2b2b : #f9f9f9);
    border-width: Tip.gtk ? 0px : 1px;
    border-color: Theme.dark ? rgba(255, 255, 255, 0.12) : rgba(0, 0, 0, 0.12);
    if Tip.gtk: Rectangle {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: parent.height - 2px;
        border-radius: 4px;
        background: Tip.gtk-bg;
    }
    tt := Text {
        visible: !Tip.gtk;
        x: 8px;
        width: parent.width - 16px;
        text: Tip.gtk ? "" : Tip.text;
        font-size: 12px;
        wrap: word-wrap;
        color: Theme.dark ? #ffffff : #1a1a1a;
        vertical-alignment: center;
    }
    // 自然行高 → pango 行高
    gm := Text { visible: false; text: "x"; font-family: Tip.gtk-font; font-size: Tip.gtk-size; }
    gt := Text {
        visible: Tip.gtk;
        x: 13px;
        y: 14px;
        text: Tip.gtk ? Tip.text : "";
        font-family: Tip.gtk-font;
        font-size: Tip.gtk-size;
        color: Tip.gtk-fg;
        wrap: no-wrap;
        line-height-factor: root.gl / max(1px, gm.preferred-height);
    }
    Timer {
        interval: Tip.gtk ? 500ms : 600ms;
        running: Tip.pending;
        triggered => {
            Tip.pending = false;
            Tip.shown = Tip.valid(Tip.rx, Tip.ry, Tip.rw, Tip.rh);
        }
    }
}

/// 24×24 线条图标（与旧版 Icon.svelte 相同：stroke-linecap/linejoin round，stroke 1.7）
export component Icon inherits Path {
    in property <string> d;
    in property <length> size: 16px;
    in property <float> sw: 1.7;
    in property <color> color: Theme.text-2;
    width: size;
    height: size;
    commands: d;
    viewbox-x: 0;
    viewbox-y: 0;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: transparent;
    stroke: color;
    stroke-width: size * sw / 24;
    stroke-line-cap: round;
    stroke-line-join: round;
}

/// .icon-btn：26×26 圆角 7；悬停 --hover 底 + 图标 text 色；:active scale(.92)；三者 120 ms ease；.on = accent
export component IconButton inherits Rectangle {
    in property <string> d;
    in property <length> icon-size: 15px;
    in property <float> sw: 1.7;
    in property <bool> on;
    in property <bool> enabled: true;
    in property <string> tip;
    in property <length> radius: 7px;
    callback clicked();
    width: 26px;
    height: 26px;
    opacity: enabled ? 1 : 0.45;
    property <bool> hov: ta.has-hover && enabled;
    property <float> k: (ta.pressed && enabled) ? 0.92 : 1;
    animate k { duration: 120ms; easing: cubic-bezier(0.2, 0.8, 0.3, 1); }
    Rectangle {
        width: root.width * root.k;
        height: root.height * root.k;
        border-radius: root.radius * root.k;
        background: root.hov ? Theme.hover : Theme.hover.transparentize(1);
        animate background { duration: 120ms; easing: cubic-bezier(0.2, 0.8, 0.3, 1); }
    }
    Icon {
        d: root.d;
        size: root.icon-size * root.k;
        sw: root.sw;
        color: root.on ? Theme.accent : (root.hov ? Theme.text : Theme.text-2);
        animate color { duration: 120ms; easing: cubic-bezier(0.2, 0.8, 0.3, 1); }
    }
    ta := TipArea {
        tip: root.tip;
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

/// 设置页 .btn：padding 4 11、r6、glass-strong 底 + .5px 边 + 0 .5px 1px 阴影；hover 混 7% text、active 11% + scale .97；
/// danger：文字 danger、hover 混 10% danger；primary（诊断）：accent 底，hover 混 8% 黑；disabled .55
export component Btn inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    in property <bool> danger;
    in property <bool> enabled: true;
    in property <string> icon;
    callback clicked();
    width: lay.preferred-width;
    // Windows 量得 25；Linux（WebKitGTK）：padding 4 + 12px 行框 + 4 + 0.5px 边 ×2（各占 1 设备像素）
    height: Fx.gtk ? 8px + Fx.lb(12px, root.text, 17px) + 2 * Fx.hair-box : 25px;
    property <bool> hov: ta.has-hover && enabled;
    property <bool> down: ta.pressed && enabled;
    property <float> k: down ? 0.97 : 1;
    animate k { duration: 120ms; easing: cubic-bezier(0.2, 0.8, 0.3, 1); }
    opacity: enabled ? 1 : 0.55;
    face := Rectangle {
        width: root.width * root.k;
        height: root.height * root.k;
        border-radius: 6px;
        background: root.primary
            ? (root.hov ? Theme.mix(Theme.accent, #000000, 0.08) : Theme.accent)
            : (root.down ? Theme.mix(Theme.glass-strong-solid, root.danger ? Theme.danger : Theme.text, root.danger ? 0.1 : 0.11)
                : (root.hov ? Theme.mix(Theme.glass-strong-solid, root.danger ? Theme.danger : Theme.text, root.danger ? 0.1 : 0.07) : Theme.glass-strong));
        animate background { duration: 120ms; easing: cubic-bezier(0.2, 0.8, 0.3, 1); }
        border-width: root.primary ? 0px : 1phx;
        border-color: Theme.glass-border;
        if !root.primary: Shadow { kind: "btn"; ew: parent.width; eh: parent.height; r: 6px; }
    }
    lay := HorizontalLayout {
        padding-left: 11px;
        padding-right: 11px;
        spacing: 5px;
        alignment: center;
        if root.icon != "": Icon { y: (parent.height - 12px) / 2; d: root.icon; size: 12px * root.k; sw: 2; color: root.primary ? Theme.accent-contrast : Theme.text; }
        Text {
            text: root.text;
            font-size: 12px * root.k;
            vertical-alignment: center;
            color: root.primary ? Theme.accent-contrast : (root.danger ? Theme.danger : Theme.text);
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

/// 经典 8px 滚动条（::-webkit-scrollbar）：拇指 4px（2px 透明边 + content-box）圆角，只在 hovered 时显示 text-3；可拖动
export component ScrollBar inherits Rectangle {
    in property <length> view-h;
    in property <length> content-h;
    in-out property <length> pos;       // Flickable 的 content-y（≤ 0）
    in property <bool> hovered;
    width: 8px;
    out property <bool> hov: ta.has-hover;
    // 溢出才有滚动条（且占 8px 宽）；布局用 shown（赋值、非绑定），避免「滚动条宽 → 内容高 → 滚动条」的绑定环
    property <bool> raw: content-h > view-h + 0.5px;
    out property <bool> shown;
    changed raw => { root.shown = root.raw; }
    init => { root.shown = root.raw; }
    visible: shown;
    property <length> track: root.height;
    property <length> th: max(18px, track * view-h / max(1px, content-h));
    property <length> range: max(0px, content-h - view-h);
    property <length> ty: range > 0 ? (track - th) * (-pos / range) : 0px;
    Rectangle {
        x: 2px;
        y: root.ty + 2px;
        width: 4px;
        height: root.th - 4px;
        border-radius: 2px;
        background: (root.hovered || ta.pressed) ? Theme.text-3 : transparent;
    }
    ta := TouchArea {
        property <length> grab;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                if self.mouse-y < root.ty || self.mouse-y > root.ty + root.th {
                    // 点轨道：翻一页
                    root.pos = clamp(root.pos + (self.mouse-y < root.ty ? root.view-h : -root.view-h), -root.range, 0px);
                }
                self.grab = self.mouse-y - root.ty;
            }
        }
        moved => {
            if self.pressed && root.track > root.th {
                let t = clamp((self.mouse-y - self.grab) / (root.track - root.th), 0, 1);
                root.pos = -t * root.range;
            }
        }
    }
}
