// 设置窗口（旧版 src/components/Settings.svelte + DiagSection.svelte）：480×620 普通窗口，可调大小。

import { Theme, Fx, Shadow, Tip, TipArea, TipBubble, Icon, Btn, ScrollBar } from "common.slint";
import { Icons } from "icons.slint";

export struct DevItem {
    id: string,
    name: string,
    sub: string,        // "Windows · 192.168.1.20"
    online: bool,
    blocked: bool,
}

/// 行内混排的一段文字（加粗用）：Rust（settings_ui::flow）按测得的宽度断行排好 x/y
export struct FlowTok {
    t: string,
    bold: bool,
    x: length,
    y: length,
}

export struct DiagCheck {
    id: string,
    title: string,
    status: string,     // ok | warn | error | unknown
    summary: string,
    detail: string,     // 详情行（每行一条，word-break: break-all）
    help: string,       // 手动办法（text 色、pre-wrap）
    fix-id: string,
    fix-label: string,
    fix-admin: bool,
    fix-confirm: string,
    result: string,     // 修复/预览结果文字
    result-cmds: string,
    result-ok: bool,
    result-fail: bool,
}

/// section：field 底 .5 边 r11 padding 6 14 10；h2 11/600 大写 letter-spacing .06em text-3 margin 8 0 4
component Section inherits Rectangle {
    in property <string> title;
    in property <float> flash;          // 跳到诊断时的闪烁环（1 → 0）
    // h2 行框：Windows 量得 15；Linux 按 Noto CJK 算（中文标题 16）
    property <length> h2-lh: Fx.lb(11px, root.title, 15px);
    background: Theme.field;
    border-width: 1phx;
    border-color: Theme.glass-border;
    border-radius: 11px;
    // sec-flash：0 0 0 2px accent 55%
    Rectangle {
        x: -2px;
        y: -2px;
        width: parent.width + 4px;
        height: parent.height + 4px;
        border-radius: 13px;
        border-width: 2px;
        border-color: Theme.accent.with-alpha(0.55 * root.flash);
        visible: root.flash > 0.001;
    }
    VerticalLayout {
        // Linux：0.5px 边框占 1 设备像素（WebKitGTK）
        padding-left: 14px + Fx.hair-box;
        padding-right: 14px + Fx.hair-box;
        padding-top: 6px + Fx.hair-box;
        padding-bottom: 10px + Fx.hair-box;
        // h2：margin 8 0 4，行框 15 —— 文字在行框（不是整个 27 高）里居中，实测与旧版同一基线
        if root.title != "": Rectangle {
            height: 8px + root.h2-lh + 4px;
            Text {
                y: 8px;
                width: parent.width;
                height: root.h2-lh;
                text: root.title;
                font-size: 11px;
                font-weight: 600;
                letter-spacing: 0.66px;
                color: Theme.text-3;
                vertical-alignment: center;
            }
        }
        @children
    }
}

/// .row：flex 居中 gap 10 min-h 34 底线；标签 13px（继承 body）
component Row inherits Rectangle {
    in property <string> label;
    in property <bool> last;
    min-height: 34px;
    HorizontalLayout {
        spacing: 10px;
        alignment: stretch;
        Text { text: root.label; font-size: 13px; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; }
        @children
    }
    if !root.last: Rectangle { y: parent.height - Fx.hair; height: Fx.hair; background: Theme.sep; }
}

/// input / textarea：.5 边 glass-strong 底 r6 padding 4 8 12.5px；focus 0 0 0 3px accent 35%（无过渡）
component Field inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> mono;
    in property <bool> multi;
    in property <bool> number;
    out property <bool> focused: ti.has-focus;
    callback edited(string);
    callback accepted(string);
    public function grab() { ti.focus(); }
    border-radius: 6px;
    background: Theme.glass-strong;
    border-width: 1phx;
    border-color: Theme.glass-border;
    Rectangle {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-radius: 9px;
        border-width: 3px;
        border-color: Theme.accent.with-alpha(0.35);
        visible: ti.has-focus;
    }
    ti := TextInput {
        x: 8px;
        y: root.multi ? 4px : 0px;
        width: parent.width - 16px - (root.number && (Fx.gtk || nta.has-hover || ti.has-focus) ? (Fx.gtk ? 18px : 14px) : 0px);
        height: root.multi ? parent.height - 8px : parent.height;
        vertical-alignment: root.multi ? top : center;
        single-line: !root.multi;
        wrap: root.multi ? word-wrap : no-wrap;
        font-size: 12.5px;
        font-family: root.mono ? "Cascadia Mono" : "";
        color: Theme.text;
        input-type: root.number ? InputType.decimal : InputType.text;
        selection-background-color: Theme.accent.with-alpha(0.35);
        text <=> root.text;
        edited => { root.edited(self.text); }
        accepted => { root.accepted(self.text); }
    }
    if root.text == "": Text {
        x: 8px;
        y: root.multi ? 4px : 0px;
        height: root.multi ? 17px : parent.height;
        vertical-alignment: center;
        text: root.placeholder;
        font-size: 12.5px;
        font-family: root.mono ? "Cascadia Mono" : "";
        color: Theme.text-3;
    }
    // type=number：悬停/聚焦时右侧出现上下微调
    nta := TouchArea {
        enabled: false;
    }
    // Linux（WebKitGTK RenderThemeAdwaita，实测）：上下微调一直在，16×19 r3 细边小盒，离右边框 7、上边框 2
    if root.number && Fx.gtk: Rectangle {
        x: parent.width - 1px - 7px - 16px;
        y: 1px + 2px;
        width: 16px;
        height: 19px;
        border-radius: 3px;
        border-width: 1px;
        border-color: Theme.dark ? rgb(65, 65, 68) : rgb(228, 228, 229);
        background: Theme.dark ? rgb(45, 45, 45) : #ffffff;
        Path {
            x: 5px;
            y: 4px;
            width: 6px;
            height: 3px;
            viewbox-width: 6;
            viewbox-height: 3;
            commands: "M0 3 L3 0 L6 3 Z";
            fill: Theme.dark ? rgb(238, 238, 236) : rgb(46, 52, 54);
        }
        Path {
            x: 5px;
            y: 12px;
            width: 6px;
            height: 3px;
            viewbox-width: 6;
            viewbox-height: 3;
            commands: "M0 0 L3 3 L6 0 Z";
            fill: Theme.dark ? rgb(238, 238, 236) : rgb(46, 52, 54);
        }
        TouchArea {
            pointer-event(e) => {
                if e.kind == PointerEventKind.down {
                    let up = self.mouse-y < self.height / 2;
                    let v = root.text.to-float();
                    let n = max(0, round((v + (up ? 100 : -100)) / 100) * 100);
                    root.text = n;
                    root.edited(root.text);
                }
            }
        }
    }
    if root.number && !Fx.gtk && (nta.has-hover || ti.has-focus): Rectangle {
        x: parent.width - 15px;
        y: 2px;
        width: 13px;
        height: parent.height - 4px;
        Path {
            width: 7px;
            height: 4px;
            y: parent.height / 2 - 6px;
            viewbox-width: 7;
            viewbox-height: 4;
            commands: "M0 4 L3.5 0 L7 4 Z";
            fill: Theme.text-2;
        }
        Path {
            width: 7px;
            height: 4px;
            y: parent.height / 2 + 2px;
            viewbox-width: 7;
            viewbox-height: 4;
            commands: "M0 0 L3.5 4 L7 0 Z";
            fill: Theme.text-2;
        }
        TouchArea {
            pointer-event(e) => {
                if e.kind == PointerEventKind.down {
                    let up = self.mouse-y < self.height / 2;
                    let v = root.text.to-float();
                    let n = max(0, round((v + (up ? 100 : -100)) / 100) * 100);
                    root.text = n;
                    root.edited(root.text);
                }
            }
        }
    }
    // textarea resize: vertical —— 右下角的拖拽手柄
    if root.multi: Rectangle {
        x: parent.width - 12px;
        y: parent.height - 12px;
        width: 11px;
        height: 11px;
        Path {
            width: 9px;
            height: 9px;
            viewbox-width: 9;
            viewbox-height: 9;
            commands: "M8.5 2 L2 8.5 M8.5 5.5 L5.5 8.5";
            stroke: Theme.text-3;
            stroke-width: 1px;
        }
        TouchArea {
            mouse-cursor: ns-resize;
            property <length> h0;
            pointer-event(e) => {
                if e.kind == PointerEventKind.down { self.h0 = root.height - self.mouse-y; }
            }
            moved => {
                if self.pressed { root.height = max(26px, self.h0 + self.mouse-y); }
            }
        }
    }
}

/// 原生 range + accent-color（宽 180）。
/// Windows（Chromium）：轨道 4px r2（已填 accent，未填灰），拇指 16px accent 圆。
/// Linux（WebKitGTK RenderThemeAdwaita，实测）：轨道 6px r3（未填：浅色黑 40/255、深色白 30/255；已填 accent 到拇指中心），
/// 拇指外径 20（1px 黑 17% 边，里面浅色 #fff、深色 #d2d2d2）。
component Slider inherits Rectangle {
    in property <float> minimum;
    in property <float> maximum: 1;
    in property <float> step: 0.01;
    in-out property <float> value;
    out property <bool> dragging: ta.pressed;
    callback changed(float);
    width: 180px;
    height: 20px;
    property <float> frac: (value - minimum) / max(0.000001, maximum - minimum);
    property <length> tk: Fx.gtk ? 20px : 16px;
    property <length> th: Fx.gtk ? 6px : 4px;
    Rectangle {
        x: 0;
        y: (parent.height - root.th) / 2;
        width: parent.width;
        height: root.th;
        border-radius: root.th / 2;
        background: Fx.gtk ? (Theme.dark ? rgba(255, 255, 255, 30 / 255) : rgba(0, 0, 0, 40 / 255)) : (Theme.dark ? #4b4b4f : #d9d9de);
        Rectangle {
            x: 0;
            width: root.tk / 2 + (root.width - root.tk) * root.frac;
            border-radius: root.th / 2;
            background: !Fx.gtk && (ta.has-hover || ta.pressed) ? Theme.mix(Theme.accent, Theme.dark ? #ffffff : #000000, 0.1) : Theme.accent;
        }
    }
    Rectangle {
        x: (root.width - root.tk) * root.frac;
        y: (root.height - root.tk) / 2;
        width: root.tk;
        height: root.tk;
        border-radius: root.tk / 2;
        background: Fx.gtk ? rgba(0, 0, 0, 0.17) : (ta.has-hover || ta.pressed ? Theme.mix(Theme.accent, Theme.dark ? #ffffff : #000000, 0.1) : Theme.accent);
        if Fx.gtk: Rectangle {
            x: 1px;
            y: 1px;
            width: parent.width - 2px;
            height: parent.height - 2px;
            border-radius: self.width / 2;
            background: Theme.dark ? #d2d2d2 : #ffffff;
        }
    }
    ta := TouchArea {
        function set(x: length) {
            let f = clamp((x - root.tk / 2) / (root.width - root.tk), 0, 1);
            let raw = root.minimum + f * (root.maximum - root.minimum);
            let v = clamp(round(raw / root.step) * root.step, root.minimum, root.maximum);
            if v != root.value { root.value = v; root.changed(v); }
        }
        pointer-event(e) => { if e.kind == PointerEventKind.down { self.set(self.mouse-x); } }
        moved => { if self.pressed { self.set(self.mouse-x); } }
        scroll-event(e) => { reject }
    }
}

/// .seg：padding 2 r7 hover 底；项 padding 3 12 r5 12px；on：seg-on + seg-on-shadow 500；hover 底；120 ms
component Seg inherits Rectangle {
    in property <[{v: string, l: string}]> items;
    in property <string> value;
    callback pick(string);
    height: 25px;
    width: lay.preferred-width;
    border-radius: 7px;
    background: Theme.hover;
    lay := HorizontalLayout {
        padding: 2px;
        spacing: 0px;
        for it in root.items: Rectangle {
            property <bool> on: root.value == it.v;
            width: tx.preferred-width + 24px;
            border-radius: 5px;
            background: self.on ? Theme.seg-on : (sta.has-hover ? Theme.hover : Theme.hover.transparentize(1));
            animate background { duration: 120ms; easing: cubic-bezier(0.2, 0.8, 0.3, 1); }
            property <float> so: self.on ? 1 : 0;
            animate so { duration: 120ms; easing: cubic-bezier(0.2, 0.8, 0.3, 1); }
            Shadow { opacity: parent.so; visible: parent.so > 0.001; kind: "seg-on"; ew: parent.width; eh: parent.height; r: 5px; }
            tx := Text { text: it.l; font-size: 12px; color: Theme.text; font-weight: parent.on ? 500 : 400; }
            sta := TouchArea { clicked => { root.pick(it.v); } }
        }
    }
}

/// .switch：38×22 r11；关 hover 底 + inset .5px glass-border；开 online；滑块 18 白 + 0 1px 3px rgba(0,0,0,.3)，
/// translateX 16（220 ms ease-spring），底色 220 ms ease
component Switch inherits Rectangle {
    in property <bool> on;
    in property <bool> enabled: true;
    callback toggled();
    width: 38px;
    height: 22px;
    border-radius: 11px;
    background: on ? Theme.online : Theme.hover;
    animate background { duration: 220ms; easing: cubic-bezier(0.2, 0.8, 0.3, 1); }
    border-width: 1phx;
    border-color: on ? Theme.glass-border.transparentize(1) : Theme.glass-border;
    animate border-color { duration: 220ms; easing: cubic-bezier(0.2, 0.8, 0.3, 1); }
    opacity: enabled ? 1 : 0.45;
    Rectangle {
        x: root.on ? 18px : 2px;
        y: 2px;
        width: 18px;
        height: 18px;
        animate x { duration: 220ms; easing: cubic-bezier(0.2, 0.9, 0.3, 1.4); }
        Shadow { kind: "knob"; ew: parent.width; eh: parent.height; r: 9px; }
        Rectangle { border-radius: 9px; background: #ffffff; }
    }
    TouchArea { enabled: root.enabled; clicked => { root.toggled(); } }
}

/// .note：11.5 text-2 line 1.5 margin 6 0 2
component Note inherits HorizontalLayout {
    in property <string> text;
    in property <color> color: Theme.text-2;
    padding-top: 6px;
    padding-bottom: 2px;
    // line-height 1.5：Linux（WebKitGTK）截断成整数 17；Windows 保持 Slint 自身行距（按 1.5x 截图量过）
    // 自然行高的量尺：宽高 0、间距 0，不影响布局
    nm := Text { visible: false; width: 0px; height: 0px; text: "x"; font-size: 11.5px; }
    Text {
        text: root.text;
        font-size: 11.5px;
        color: root.color;
        wrap: word-wrap;
        line-height-factor: Fx.gtk ? Fx.lh(11.5px, 1.5) / max(1px, nm.preferred-height) : 1;
        // 折行后的高度要进布局：Slint 的 preferred-height 按不折行算，滚动区的内容高因此会少几行
        property <length> lhv: Fx.gtk ? Fx.lh(11.5px, 1.5) : nm.preferred-height;
        property <int> lines: max(1, ceil(self.preferred-width / max(1px, self.width) - 0.02));
        min-height: self.lines * self.lhv;
    }
}

/// 带 <b> 的说明段落（.note：11.5 text-2 line-height 1.5）。StyledText 在软件渲染器里加粗失效，
/// 所以每段（词 / 汉字）一个 Text：先各自报宽度，Rust 断行后回填坐标，行高 17.25 与 CSS 相同
component FlowNote inherits Rectangle {
    in property <[FlowTok]> toks;
    in property <int> lines: 1;
    callback measured(int, length);
    callback width-changed(length);
    // 关于里的这段是 `.about p`（12px、margin 4 0，比 .note 的 11.5 / 6 0 2 优先）。Windows 按 1.5x 截图保持 11.5 / 6 / 2
    in property <length> fs: Fx.gtk ? 12px : 11.5px;
    in property <length> pt: Fx.gtk ? 4px : 6px;
    in property <length> pb: Fx.gtk ? 4px : 2px;
    height: root.pt + root.lines * Fx.lh(root.fs, 1.5) + root.pb;
    changed width => { root.width-changed(self.width); }
    init => { root.width-changed(self.width); }
    for t[i] in root.toks: Text {
        x: t.x;
        y: root.pt + t.y;
        height: Fx.lh(root.fs, 1.5);
        vertical-alignment: center;
        text: t.t;
        font-size: root.fs;
        font-weight: t.bold ? 700 : 400;
        color: Theme.text-2;
        init => { root.measured(i, self.preferred-width); }
    }
}

/// em：11.5 text-2 min-w 54 右对齐
component Em inherits Text {
    font-size: 11.5px;
    color: Theme.text-2;
    min-width: 54px;
    horizontal-alignment: right;
    vertical-alignment: center;
}

/// 链接样式按钮（预览命令）：11.5 accent，hover 下划线
component LinkBtn inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked();
    width: lt.preferred-width;
    opacity: enabled ? 1 : 0.55;
    lt := Text { text: root.text; font-size: 11.5px; color: Theme.accent; vertical-alignment: center; }
    Rectangle {
        x: 0;
        y: (parent.height + lt.preferred-height) / 2 - 1.5px;
        width: parent.width;
        height: 0.8px;
        background: lta.has-hover && root.enabled ? Theme.accent : transparent;
    }
    lta := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
}

component CheckRow inherits Rectangle {
    in property <DiagCheck> c;
    in property <string> busy;          // "<fix id>:<dry>" 正在执行的那一个
    in property <string> confirming;
    in property <bool> last;
    callback fix(string, bool);
    callback confirm(string);
    callback cancel-confirm();
    property <bool> open;
    // 展开箭头旋转 90°（160 ms ease）
    property <float> rot: open ? 90 : 0;
    animate rot { duration: 160ms; easing: cubic-bezier(0.2, 0.8, 0.3, 1); }
    // 自然行高的量尺（放在布局外面：隐藏的元素在布局里照样占位）
    dmm := Text { visible: false; text: "x"; font-size: 11px; }
    smm := Text { visible: false; text: "x"; font-size: 11.5px; }
    property <color> scol: c.status == "ok" ? Theme.online : (c.status == "warn" ? Theme.warn : (c.status == "error" ? Theme.danger : Theme.text-3));
    height: lay.preferred-height;
    lay := VerticalLayout {
        padding-top: 8px;
        // Linux：.check 的 0.5px 底边占 1 设备像素
        padding-bottom: 8px + (root.last ? 0px : Fx.hair-box);
        HorizontalLayout {
            spacing: 10px;
            VerticalLayout {
                padding-top: 4px;
                alignment: start;
                // 点 9px + 3px 光环（18–20%）；unknown：透明 + inset 1.5px text-3
                Rectangle {
                    width: 9px;
                    height: 9px;
                    if root.c.status != "unknown": Rectangle {
                        width: 15px;
                        height: 15px;
                        border-radius: 7.5px;
                        background: root.scol.with-alpha(root.c.status == "warn" ? 0.2 : 0.18);
                    }
                    Rectangle {
                        border-radius: 4.5px;
                        background: root.c.status == "unknown" ? transparent : root.scol;
                        border-width: root.c.status == "unknown" ? 1.5px : 0px;
                        border-color: Theme.text-3;
                    }
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                // margin-top 1；Windows 再加 1：说明行比旧版高 2 物理像素（1.5x 实测）
                spacing: Fx.gtk ? 1px : 2px;
                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    // .title 行框：12.5px 中文 normal 行高 16.67（> 徽标 16），每项因此比按 16 排高 0.67
                    min-height: Fx.lb(12.5px, root.c.title, 16.67px);
                    Text { text: root.c.title; font-size: 12.5px; font-weight: 500; color: Theme.text; vertical-alignment: center; }
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: bt.preferred-width + 12px;
                            height: 16px;
                            border-radius: 8px;
                            background: root.c.status == "ok" ? Theme.online.with-alpha(0.14) : (root.c.status == "warn" ? Theme.warn.with-alpha(0.16) : (root.c.status == "error" ? Theme.danger.with-alpha(0.13) : Theme.hover));
                            bt := Text {
                                text: root.c.status == "ok" ? "正常" : (root.c.status == "warn" ? "注意" : (root.c.status == "error" ? "有问题" : "无法检测"));
                                font-size: 10px;
                                font-weight: 500;
                                color: root.c.status == "ok" ? Theme.mix(Theme.online, Theme.text, 0.3) : (root.c.status == "warn" ? Theme.mix(Theme.warn, Theme.text, 0.25) : (root.c.status == "error" ? Theme.danger : Theme.text-2));
                            }
                        }
                    }
                }
                // .summary：11.5px line-height 1.45（16.675/行）。Slint 行距取字体度量（11.5px ≈ 14.67/行，实测 1.5x 截图），
                // 按行数换成 CSS 的总高度，文字在里面居中：首行逐像素对齐，之后每行差 ≤1px，不再逐行累积
                sm := Text {
                    // Linux：行高 = WebKitGTK 截断后的 16，用 line-height-factor 逐行对齐
                    property <length> lhv: Fx.lh(11.5px, 1.45);
                    line-height-factor: Fx.gtk ? self.lhv / max(1px, smm.preferred-height) : 1;
                    property <int> lines: Fx.gtk ? max(1, ceil(self.preferred-width / max(1px, self.width) - 0.02)) : max(1, round(self.preferred-height / 14.67px));
                    text: root.c.summary;
                    font-size: 11.5px;
                    color: Theme.text-2;
                    wrap: word-wrap;
                    height: self.lines * self.lhv;
                    vertical-alignment: center;
                }
            }
            if root.c.detail != "" || root.c.help != "": VerticalLayout {
                alignment: start;
                Rectangle {
                    width: 22px;
                    height: 22px;
                    border-radius: 6px;
                    background: mta.has-hover ? Theme.hover : Theme.hover.transparentize(1);
                    animate background { duration: 120ms; easing: cubic-bezier(0.2, 0.8, 0.3, 1); }
                    Icon { d: Fx.rotate-path("M9 6l6 6-6 6", root.rot); size: 12px; sw: 2.2; color: Theme.text-3; }
                    mta := TouchArea { clicked => { root.open = !root.open; } }
                }
            }
        }
        // 详情：margin 6 0 0 19，padding 6 9，r7，hover 底，11px line 1.55
        if root.open && (root.c.detail != "" || root.c.help != ""): HorizontalLayout {
            padding-top: 6px;
            padding-left: 19px;
            Rectangle {
                height: dl.preferred-height;
                border-radius: 7px;
                background: Theme.hover;
                dl := VerticalLayout {
                    padding-top: 6px;
                    padding-bottom: 6px;
                    padding-left: 9px;
                    padding-right: 9px;
                    if root.c.detail != "": TextInput {
                        read-only: true;
                        text: root.c.detail;
                        font-size: 11px;
                        line-height-factor: Fx.gtk ? Fx.lh(11px, 1.55) / max(1px, dmm.preferred-height) : 1;
                        color: Theme.text-2;
                        wrap: char-wrap;
                        single-line: false;
                        selection-background-color: Theme.accent.with-alpha(0.35);
                    }
                    if root.c.help != "": HorizontalLayout {
                        padding-top: root.c.detail != "" ? 4px : 0px;
                        TextInput {
                            read-only: true;
                            text: root.c.help;
                            font-size: 11px;
                            line-height-factor: Fx.gtk ? Fx.lh(11px, 1.55) / max(1px, dmm.preferred-height) : 1;
                            color: Theme.text;
                            wrap: word-wrap;
                            single-line: false;
                            selection-background-color: Theme.accent.with-alpha(0.35);
                        }
                    }
                }
            }
        }
        // 确认框：padding 8 10 r8 #ff9f0a 12% 底 40% 边
        if root.c.fix-id != "" && root.confirming == root.c.fix-id: HorizontalLayout {
            padding-top: 7px;
            padding-left: 19px;
            Rectangle {
                height: cl.preferred-height;
                border-radius: 8px;
                background: Theme.warn.with-alpha(0.12);
                border-width: 1phx;
                border-color: Theme.warn.with-alpha(0.4);
                cl := VerticalLayout {
                    padding-top: 8px;
                    padding-bottom: 8px;
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 7px;
                    Text { text: root.c.fix-confirm; font-size: 11.5px; color: Theme.text; wrap: word-wrap; }
                    HorizontalLayout {
                        alignment: end;
                        spacing: 8px;
                        Btn { text: "取消"; clicked => { root.cancel-confirm(); } }
                        Btn { text: "确定修改"; primary: true; clicked => { root.fix(root.c.fix-id, false); } }
                    }
                }
            }
        }
        // 操作：margin 7 0 0 19 gap 10
        if root.c.fix-id != "" && root.confirming != root.c.fix-id: HorizontalLayout {
            spacing: 10px;
            alignment: start;
            padding-left: 19px;
            padding-top: 7px;
            Btn {
                text: root.busy == root.c.fix-id + ":false" ? "正在修复…" : root.c.fix-label;
                icon: root.c.fix-admin ? "M12 3 5 6v5c0 4.5 3 8.3 7 10 4-1.7 7-5.5 7-10V6z" : "";
                primary: root.c.status == "error" || root.c.status == "warn";
                enabled: root.busy == "";
                clicked => {
                    if root.c.fix-confirm != "" { root.confirm(root.c.fix-id); } else { root.fix(root.c.fix-id, false); }
                }
            }
            LinkBtn {
                text: root.busy == root.c.fix-id + ":true" ? "生成中…" : "预览命令";
                enabled: root.busy == "";
                clicked => { root.fix(root.c.fix-id, true); }
            }
            if root.c.fix-admin: Text { text: "需要一次管理员授权"; font-size: 10.5px; color: Theme.text-3; vertical-alignment: center; }
        }
        // 结果：margin 7 0 0 19，padding 6 9 r7 11.5；pre：glass-strong 底 .5 边 r6 mono 10.5
        if root.c.result != "": HorizontalLayout {
            padding-top: 7px;
            padding-left: 19px;
            Rectangle {
                height: rl.preferred-height;
                border-radius: 7px;
                background: root.c.result-fail ? Theme.danger.with-alpha(0.12) : (root.c.result-ok ? Theme.online.with-alpha(0.14) : Theme.hover);
                rl := VerticalLayout {
                    padding-top: 6px;
                    padding-bottom: 6px;
                    padding-left: 9px;
                    padding-right: 9px;
                    Text { text: root.c.result; font-size: 11.5px; color: Theme.text; wrap: word-wrap; }
                    if root.c.result-cmds != "": HorizontalLayout {
                        padding-top: 6px;
                        Rectangle {
                            height: pre.preferred-height + 12px;
                            border-radius: 6px;
                            background: Theme.glass-strong;
                            border-width: 1phx;
                            border-color: Theme.glass-border;
                            pre := TextInput {
                                x: 8px;
                                y: 6px;
                                width: parent.width - 16px;
                                read-only: true;
                                single-line: false;
                                text: root.c.result-cmds;
                                font-size: 10.5px;
                                font-family: "Cascadia Mono";
                                color: Theme.text;
                                wrap: char-wrap;
                                selection-background-color: Theme.accent.with-alpha(0.35);
                            }
                        }
                    }
                }
            }
        }
    }
    if !root.last: Rectangle { y: parent.height - Fx.hair; height: Fx.hair; background: Theme.sep; }
}

// GTK（adw-gtk3 / Breeze）客户端装饰标题栏，按旧版在 niri 上的截图量：高 36 + 底边 1，
// 背景 #fff8f8、底边 #e1dbdb、标题 Noto Sans 粗体 10pt 居中、右侧三个 24px 圆钮（#e9e2e2，间距 38，右边距 8）
component CsdButton inherits Rectangle {
    callback clicked();
    width: 24px;
    height: 24px;
    border-radius: 12px;
    background: ta.pressed ? #d2cbcb : (ta.has-hover ? #ddd6d6 : #e9e2e2);
    ta := TouchArea { clicked => { root.clicked(); } }
}

component CsdBar inherits Rectangle {
    in property <string> title;
    in property <bool> maximized;
    callback act(int, length, length);
    height: 37px;
    background: #fff8f8;
    property <duration> last-click: 0ms;
    TouchArea {
        height: 36px;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                // 双击 = 最大化 / 还原（GTK 默认），单击按住 = 拖动
                if animation-tick() - root.last-click < 400ms {
                    root.last-click = 0ms;
                    root.act(2, self.mouse-x, self.mouse-y);
                } else {
                    root.last-click = animation-tick();
                    root.act(0, self.mouse-x, self.mouse-y);
                }
            }
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.right {
                root.act(4, self.mouse-x, self.mouse-y);
            }
        }
    }
    Text {
        y: 0px;
        height: 36px;
        width: parent.width;
        text: root.title;
        font-family: "Noto Sans";
        font-size: 13.33px;
        font-weight: 700;
        color: #2f2f30;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    CsdButton { x: parent.width - 9px - 24px - 38px * 2; y: 6px; clicked => { root.act(1, 0, 0); } }
    CsdButton { x: parent.width - 9px - 24px - 38px; y: 6px; clicked => { root.act(2, 0, 0); } }
    CsdButton { x: parent.width - 9px - 24px; y: 6px; clicked => { root.act(3, 0, 0); } }
    Rectangle { y: 36px; height: 1px; background: #e1dbdb; }
}

export component SettingsWindow inherits Window {
    title: "Lancat 设置";
    preferred-width: 480px;
    preferred-height: 620px + root.csd-h;
    min-width: 420px;
    min-height: 480px + root.csd-h;
    background: Theme.glass-strong-solid;
    default-font-size: 13px;
    default-font-family: Fx.font;

    in property <bool> saved-flash;
    in property <int> saved-gen;
    // 本机
    in-out property <string> device-name;
    in property <string> me-name;
    in property <string> me-id;
    in property <string> me-port;
    in property <string> me-ver;
    in property <string> me-os;
    // 停靠
    in property <string> dock-edge;
    in-out property <float> dock-offset;
    in-out property <float> dock-length;
    in-out property <float> hover-delay;
    in-out property <float> collapse-delay;
    in-out property <float> keep-alive;
    in property <[string]> monitors;
    in property <int> dock-monitor;
    // 接收
    in property <string> recv-dir;
    in property <string> recv-dir-shown;
    in property <bool> recv-custom;
    in-out property <string> max-file-mb;
    // 设备
    in property <[DevItem]> devices;
    in-out property <string> blocked-ips;
    in property <[string]> manual-peers;
    // 公网连接
    in property <bool> public-access;
    in property <string> pair-code;
    in property <[DevItem]> paired-remotes;   // id / name / sub
    in property <[DevItem]> remote-peers;     // id = 地址
    callback toggle-public();
    callback regen-code();
    callback unpair(string);
    callback remove-remote(string);
    callback add-remote(string, string);
    public function focus-remote-code() { f-rcode.grab(); }
    public function focus-remote-addr() { f-raddr.grab(); }
    in-out property <string> remote-addr;
    in-out property <string> remote-code;
    in property <string> remote-msg;
    in property <bool> remote-msg-bad;
    out property <length> pub-y: pub-sec.y;
    out property <length> pub-addr-y: pub-sec.y + pub-join.y;
    // 通用
    in property <bool> autostart;
    // 更新："idle" | "checking" | "latest" | "available" | "downloading" | "error"
    in property <string> upd-state;
    in property <string> upd-text;
    in property <bool> auto-update: true;
    in property <bool> message-sound: true;
    callback toggle-message-sound();
    callback check-update();
    callback do-update();
    callback open-release();
    callback toggle-auto-update();
    in property <bool> autostart-enabled: true;
    in property <string> theme: "system";
    in property <bool> confirm-clear;
    in property <int> emoji-count;
    in property <[FlowTok]> about-toks;
    in property <int> about-lines: 1;
    callback about-measured(int, length);
    callback about-width(length);
    // 诊断
    in property <[DiagCheck]> checks;
    in property <int> problems: -1;   // -1 = 尚未检查
    in property <string> diag-time;
    in property <bool> checking;
    in property <bool> dry-run-forced;
    in property <string> diag-error;
    in property <string> fix-busy;
    in property <float> diag-flash;
    in-out property <string> confirming;
    in-out property <length> scroll-y <=> fl.content-y;
    out property <length> diag-y: diag-sec.y;
    out property <length> view-h: fl.height;
    out property <length> content-h: fl.content-height;
    // 正在编辑：滑块按着 / 输入框有焦点 —— 这时不拿保存回来的设置覆盖界面（旧值回写会让滑块跳回去）
    out property <bool> editing: s1.dragging || s2.dragging || s3.dragging || s4.dragging || s5.dragging || f-name.focused || f-mb.focused || f-ips.focused;

    callback save();                  // 文本/滑块类：防抖保存
    callback save-now();
    callback set-edge(string);
    callback set-monitor(int);
    callback set-theme(string);
    callback pick-dir();
    callback reset-dir();
    callback toggle-block(string);
    callback remove-manual(string);
    callback toggle-autostart();
    callback clear-all();
    callback recheck();
    callback run-fix(string, bool);

    property <bool> mon-open;
    // Wayland 下 compositor 要客户端自己画装饰：旧版是 GTK 的标题栏（36 + 底边 1，标题居中加粗，右侧三个圆钮）
    in property <bool> csd;
    in property <bool> csd-maximized;
    callback csd-act(int, length, length);
    property <length> csd-h: root.csd ? 37px : 0px;

    hov := TouchArea {
    y: root.csd-h;
    height: parent.height - root.csd-h;
    fl := Flickable {
        width: parent.width;
        height: parent.height;
        content-height: col.preferred-height;
        // Linux：WebKitGTK 的 8px 经典滚动条占布局宽，内容按剩下的宽居中（实测比不减时左移 4px）
        content-width: self.width - (Fx.gtk && sb.shown ? 8px : 0px);
        HorizontalLayout {
            width: fl.width - (sb.shown ? 8px : 0px);
            alignment: center;
        col := VerticalLayout {
            max-width: 620px;
            horizontal-stretch: 1;
            padding-left: 22px;
            padding-right: 22px;
            padding-top: 18px;
            // 旧版最后一个 section 还有 margin-bottom 14px（滚到底时多出的留白）
            padding-bottom: 30px + 14px;
            spacing: 14px;
            HorizontalLayout {
                spacing: 10px;
                alignment: start;
                Text { text: "Lancat 设置"; font-size: 17px; font-weight: 700; color: Theme.text; vertical-alignment: center; height: Fx.lb(17px, self.text, self.preferred-height); }
                // 已保存：1.2 s，70% 之前不透明，之后淡出
                if root.saved-flash: Text {
                    property <float> t: 0;
                    init => { self.t = 1; }
                    animate t { duration: 1200ms; easing: linear; }
                    opacity: self.t < 0.7 ? 1 : 1 - (self.t - 0.7) / 0.3;
                    text: "已保存";
                    font-size: 11px;
                    font-weight: 500;
                    color: Theme.online;
                    vertical-alignment: center;
                }
            }
            Section {
                title: "本机";
                Row {
                    label: "设备名称";
                    VerticalLayout {
                        alignment: center;
                        f-name := Field {
                            width: 220px;
                            height: 26px;
                            text <=> root.device-name;
                            placeholder: root.me-name;
                            edited => { root.save(); }
                        }
                    }
                }
                Row {
                    label: "设备 ID";
                    TextInput { read-only: true; text: root.me-id; font-size: 11px; font-family: "Cascadia Mono"; color: Theme.text-2; vertical-alignment: center; selection-background-color: Theme.accent.with-alpha(0.35); }
                }
                Row { label: "服务端口"; last: true; Text { text: "TCP/UDP " + root.me-port; font-size: 11px; font-family: "Cascadia Mono"; color: Theme.text-2; vertical-alignment: center; } }
            }
            diag-sec := Section {
                flash: root.diag-flash;
                VerticalLayout {
                    HorizontalLayout {
                        spacing: 8px;
                        // .head margin 8 0 4；外加 1px：旧版按钮与下面各项都比按 8 排低 1.5 物理像素（1.5x 实测）
                        padding-top: 9px;
                        padding-bottom: 4px;
                        Text { text: "权限与诊断"; font-size: 11px; font-weight: 600; letter-spacing: 0.66px; color: Theme.text-3; vertical-alignment: center; }
                        if root.problems >= 0: Text {
                            text: root.problems > 0 ? "发现 " + root.problems + " 个问题" : "一切正常";
                            font-size: 11px;
                            font-weight: 500;
                            color: root.problems > 0 ? Theme.danger : Theme.online;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        if root.diag-time != "": Text { text: root.diag-time + " 检查"; font-size: 10.5px; color: Theme.text-3; vertical-alignment: center; }
                        VerticalLayout { alignment: center; Btn { text: root.checking ? "检查中…" : "重新检查"; enabled: !root.checking; clicked => { root.recheck(); } } }
                    }
                    if root.diag-error != "": Note { text: root.diag-error; color: Theme.danger; }
                    if root.problems < 0 && root.diag-error == "": Note { text: "正在检查…"; }
                    if root.dry-run-forced: Note { text: "已开启演练模式（LANCAT_FIX_DRY_RUN）：修复只显示将要执行的命令，不做修改。"; }
                    for c[i] in root.checks: CheckRow {
                        c: c;
                        last: i == root.checks.length - 1;
                        busy: root.fix-busy;
                        confirming: root.confirming;
                        fix(id, dry) => { root.confirming = ""; root.run-fix(id, dry); }
                        confirm(id) => { root.confirming = id; }
                        cancel-confirm => { root.confirming = ""; }
                    }
                }
            }
            Section {
                title: "停靠";
                Row {
                    label: "屏幕边缘";
                    VerticalLayout {
                        alignment: center;
                        Seg {
                            items: [{ v: "left", l: "左" }, { v: "right", l: "右" }, { v: "top", l: "上" }, { v: "bottom", l: "下" }];
                            value: root.dock-edge;
                            pick(v) => { root.set-edge(v); }
                        }
                    }
                }
                Row {
                    label: "位置";
                    VerticalLayout { alignment: center; s1 := Slider { minimum: 0; maximum: 1; step: 0.01; value <=> root.dock-offset; changed => { root.save(); } } }
                    Em { text: round(root.dock-offset * 100) + "%"; }
                }
                Row {
                    label: "隐藏条长度";
                    VerticalLayout { alignment: center; s2 := Slider { minimum: 60; maximum: 800; step: 10; value <=> root.dock-length; changed => { root.save(); } } }
                    Em { text: round(root.dock-length) + "px"; }
                }
                if root.monitors.length > 1: Row {
                    label: "显示器";
                    VerticalLayout {
                        alignment: center;
                        // 原生 select 的样子：.5 边 glass-strong 底 r6 padding 4 8 12.5px + 右侧下拉箭头
                        Rectangle {
                            width: ml.preferred-width + 8px + 26px;
                            height: 26px;
                            border-radius: 6px;
                            background: Theme.glass-strong;
                            border-width: 1phx;
                            border-color: Theme.glass-border;
                            ml := Text { x: 8px; text: root.monitors[root.dock-monitor]; font-size: 12.5px; color: Theme.text; vertical-alignment: center; height: parent.height; }
                            Icon { x: parent.width - 18px; d: "M6 9l6 6 6-6"; size: 12px; sw: 2; color: Theme.text-2; }
                            TouchArea { clicked => { root.mon-open = !root.mon-open; } }
                            if root.mon-open: Rectangle {
                                y: parent.height + 2px;
                                width: max(parent.width, 200px);
                                height: root.monitors.length * 24px + 8px;
                                border-radius: 6px;
                                background: Theme.glass-strong-solid;
                                border-width: 1phx;
                                border-color: Theme.glass-border;
                                Shadow { kind: "glass"; ew: parent.width; eh: parent.height; r: 6px; }
                                VerticalLayout {
                                    padding: 4px;
                                    for m[i] in root.monitors: Rectangle {
                                        height: 24px;
                                        border-radius: 4px;
                                        background: mta.has-hover ? Theme.accent : transparent;
                                        Text { x: 8px; text: m; font-size: 12.5px; color: mta.has-hover ? Theme.accent-contrast : Theme.text; vertical-alignment: center; height: parent.height; }
                                        mta := TouchArea { clicked => { root.mon-open = false; root.set-monitor(i); } }
                                    }
                                }
                            }
                        }
                    }
                }
                Row {
                    label: "悬停弹出延迟";
                    VerticalLayout { alignment: center; s3 := Slider { minimum: 0; maximum: 800; step: 10; value <=> root.hover-delay; changed => { root.save(); } } }
                    Em { text: round(root.hover-delay) + "ms"; }
                }
                Row {
                    label: "离开后收起延迟";
                    VerticalLayout { alignment: center; s4 := Slider { minimum: 0; maximum: 5000; step: 50; value <=> root.collapse-delay; changed => { root.save(); } } }
                    Em { text: round(root.collapse-delay) + "ms"; }
                }
                Row {
                    label: "收起后释放面板";
                    // 后面还有 .note：不是 :last-child，Linux 上照样有底线（Windows 按 1.5x 截图保持原样）
                    last: !Fx.gtk;
                    VerticalLayout { alignment: center; s5 := Slider { minimum: 0; maximum: 7200; step: 60; value <=> root.keep-alive; changed => { root.save(); } } }
                    Em { text: root.keep-alive == 0 ? "常驻" : (root.keep-alive < 60 ? round(root.keep-alive) + "s" : round(root.keep-alive / 60) + " 分钟"); }
                }
                Note { text: "面板收起几秒后会先冻结（不占 CPU，内存交还系统），再次弹出几乎是瞬间；超过这个时间才彻底释放界面，下次弹出要重新构建。设为 0 表示永不释放。"; }
            }
            Section {
                title: "接收";
                Row {
                    label: "接收目录";
                    // direction: rtl + 省略号：显示路径的末尾，开头省略
                    TipArea {
                        tip: root.recv-dir;
                        max-width: 300px;
                        preferred-width: min(300px, rd.preferred-width);
                        horizontal-stretch: 0;
                        rd := Text {
                            x: min(0px, parent.width - self.preferred-width);
                            width: self.preferred-width;
                            height: parent.height;
                            text: root.recv-dir-shown;
                            font-size: 11px;
                            font-family: "Cascadia Mono";
                            color: Theme.text-2;
                            vertical-alignment: center;
                        }
                        if rd.preferred-width > parent.width: Rectangle {
                            x: 0;
                            width: el.preferred-width + 1px;
                            height: parent.height;
                            background: Theme.mix(Theme.glass-strong-solid, Theme.dark ? #ffffff : #ffffff, Theme.dark ? 0.07 : 0.7);
                            el := Text { text: "…"; font-size: 11px; font-family: "Cascadia Mono"; color: Theme.text-2; vertical-alignment: center; }
                        }
                    }
                }
                Rectangle {
                    height: 34px;
                    HorizontalLayout {
                        alignment: end;
                        spacing: 6px;
                        VerticalLayout { alignment: center; Btn { text: "选择…"; clicked => { root.pick-dir(); } } }
                        if root.recv-custom: VerticalLayout { alignment: center; Btn { text: "恢复默认（下载）"; clicked => { root.reset-dir(); } } }
                    }
                }
                Row {
                    label: "单文件大小上限";
                    // 后面还有 .note：不是 :last-child，Linux 上照样有底线（Windows 按 1.5x 截图保持原样）
                    last: !Fx.gtk;
                    VerticalLayout { alignment: center; f-mb := Field { width: 90px; height: 26px; number: true; text <=> root.max-file-mb; edited => { root.save(); } } }
                    Em { text: "MB（0 = 不限）"; }
                }
                Note { text: "收到的文件直接保存、自动重名，永远不会被自动打开或执行。"; }
            }
            Section {
                title: "设备与黑名单";
                if root.devices.length == 0: Note { text: "还没有发现其他设备。"; }
                for d in root.devices: Rectangle {
                    min-height: 34px;
                    HorizontalLayout {
                        spacing: 10px;
                        padding-bottom: Fx.hair-box;
                        VerticalLayout { alignment: center; Rectangle { width: 8px; height: 8px; border-radius: 4px; background: d.online ? Theme.online : Theme.text-3; } }
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            // 行框：Linux 按 WebKitGTK 的字体度量（名字含中文时更高），Windows 保持 Slint 自身
                            Text { text: d.name; font-size: 12.5px; color: Theme.text; overflow: elide; height: Fx.gtk ? Fx.lb(12.5px, self.text, 0px) : self.preferred-height; vertical-alignment: center; }
                            Text { text: d.sub; font-size: 10.5px; color: Theme.text-3; overflow: elide; height: Fx.gtk ? Fx.lb(10.5px, self.text, 0px) : self.preferred-height; vertical-alignment: center; }
                        }
                        VerticalLayout { alignment: center; Btn { text: d.blocked ? "取消拉黑" : "拉黑"; danger: !d.blocked; clicked => { root.toggle-block(d.id); } } }
                    }
                    Rectangle { y: parent.height - Fx.hair; height: Fx.hair; background: Theme.sep; }
                }
                VerticalLayout {
                    padding-top: 8px;
                    padding-bottom: 2px;
                    spacing: 5px;
                    Text { text: "按 IP 拉黑（每行一个）"; font-size: 13px; color: Theme.text; }
                    f-ips := Field { height: Fx.gtk ? 2 * 15px + 8px + 2 * Fx.hair-box : 2 * 17px + 8px + 1px; multi: true; mono: true; text <=> root.blocked-ips; placeholder: "192.168.1.66"; edited => { root.save(); } }
                }
                if root.manual-peers.length > 0: VerticalLayout {
                    padding-top: 8px;
                    padding-bottom: 2px;
                    spacing: 5px;
                    Text { text: "手动添加的设备（每 5 秒探测一次）"; font-size: 13px; color: Theme.text; }
                    for a in root.manual-peers: Rectangle {
                        min-height: 34px;
                        HorizontalLayout {
                            spacing: 10px;
                            Text { text: a; font-size: 11px; font-family: "Cascadia Mono"; color: Theme.text-2; vertical-alignment: center; horizontal-stretch: 1; }
                            VerticalLayout { alignment: center; Btn { text: "移除"; clicked => { root.remove-manual(a); } } }
                        }
                    }
                }
            }
            pub-sec := Section {
                title: "公网连接";
                Row {
                    label: "允许通过公网地址连接";
                    last: !root.public-access;
                    VerticalLayout { alignment: center; Switch { on: root.public-access; toggled => { root.toggle-public(); } } }
                }
                if root.public-access: Row {
                    label: "配对码";
                    last: true;
                    VerticalLayout { alignment: center; Text { text: root.pair-code; font-size: 14px; font-family: "Cascadia Mono"; font-weight: 600; color: Theme.text; } }
                    VerticalLayout { alignment: center; Btn { text: "换一个"; clicked => { root.regen-code(); } } }
                }
                if root.public-access: Note { text: "用 Cloudflare Tunnel 或 frp 把本机 TCP 47820 端口开到公网（frpc / cloudflared 要和 Lancat 在同一台电脑上），把地址和配对码发给对方。对方在 Lancat 的「设置 → 公网连接 → 连接别人开放的地址」里填上即可。配对后对方不再需要配对码；换配对码不影响已配对的设备。"; }
                if !root.public-access: Note { text: "打开后，别人可以通过你用 Cloudflare Tunnel / frp 开出去的地址连过来，但必须先输入配对码。只在局域网用就不用打开。"; }
                for d in root.paired-remotes: Rectangle {
                    min-height: 34px;
                    HorizontalLayout {
                        spacing: 10px;
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Text { text: d.name; font-size: 12.5px; color: Theme.text; overflow: elide; }
                            Text { text: d.sub; font-size: 10.5px; color: Theme.text-3; overflow: elide; }
                        }
                        VerticalLayout { alignment: center; Btn { text: "解除配对"; danger: true; clicked => { root.unpair(d.id); } } }
                    }
                }
                pub-join := VerticalLayout {
                    padding-top: 10px;
                    padding-bottom: 2px;
                    spacing: 6px;
                    Text { text: "连接别人开放的地址"; font-size: 13px; color: Theme.text; }
                    HorizontalLayout {
                        spacing: 8px;
                        f-raddr := Field { height: 26px; horizontal-stretch: 3; mono: true; text <=> root.remote-addr; placeholder: "https://lancat.example.com 或 域名:端口"; accepted => { f-rcode.grab(); } }
                        f-rcode := Field { height: 26px; width: 110px; mono: true; text <=> root.remote-code; placeholder: "配对码"; accepted => { root.add-remote(root.remote-addr, root.remote-code); } }
                        VerticalLayout { alignment: center; Btn { text: "连接"; clicked => { root.add-remote(root.remote-addr, root.remote-code); } } }
                    }
                    if root.remote-msg != "": Text { text: root.remote-msg; font-size: 11.5px; color: root.remote-msg-bad ? Theme.danger : Theme.text-2; wrap: word-wrap; }
                    Note { text: "地址和配对码由对方提供：对方在自己 Lancat 的「设置 → 公网连接」里打开开关就能看到配对码。只需配对一次，以后自动连接。"; }
                }
                if root.remote-peers.length > 0: VerticalLayout {
                    padding-top: 8px;
                    spacing: 5px;
                    Text { text: "我连接的公网地址"; font-size: 13px; color: Theme.text; }
                    for d in root.remote-peers: Rectangle {
                        min-height: 34px;
                        HorizontalLayout {
                            spacing: 10px;
                            VerticalLayout { alignment: center; Rectangle { width: 8px; height: 8px; border-radius: 4px; background: d.online ? Theme.online : Theme.text-3; } }
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                Text { text: d.name; font-size: 12.5px; color: Theme.text; overflow: elide; }
                                Text { text: d.sub; font-size: 10.5px; color: Theme.text-3; overflow: elide; }
                            }
                            VerticalLayout { alignment: center; Btn { text: "移除"; clicked => { root.remove-remote(d.id); } } }
                        }
                    }
                }
            }
            Section {
                title: "通用";
                Row {
                    label: "开机自动启动";
                    VerticalLayout { alignment: center; Switch { on: root.autostart; enabled: root.autostart-enabled; toggled => { root.toggle-autostart(); } } }
                }
                Row {
                    label: "新消息提示音";
                    VerticalLayout { alignment: center; Switch { on: root.message-sound; toggled => { root.toggle-message-sound(); } } }
                }
                Row {
                    label: "外观";
                    last: true;
                    VerticalLayout {
                        alignment: center;
                        Seg {
                            items: [{ v: "system", l: "跟随系统" }, { v: "light", l: "浅色" }, { v: "dark", l: "深色" }];
                            value: root.theme;
                            pick(v) => { root.set-theme(v); }
                        }
                    }
                }
            }
            Section {
                title: "数据";
                Row {
                    label: "聊天记录永久保存在本机";
                    last: true;
                    VerticalLayout { alignment: center; Btn { text: root.confirm-clear ? "再点一次确认清空" : "清空全部聊天记录"; danger: true; clicked => { root.clear-all(); } } }
                }
            }
            Section {
                title: "更新";
                Row {
                    label: root.upd-text;
                    if root.upd-state == "available" || root.upd-state == "ready": VerticalLayout { alignment: center; Btn { text: "更新说明"; clicked => { root.open-release(); } } }
                    VerticalLayout {
                        alignment: center;
                        Btn {
                            text: root.upd-state == "available" ? "立即更新" : root.upd-state == "ready" ? "立即安装" : root.upd-state == "checking" ? "检查中…" : root.upd-state == "downloading" ? "正在更新…" : "检查更新";
                            primary: root.upd-state == "available" || root.upd-state == "ready";
                            enabled: root.upd-state != "checking" && root.upd-state != "downloading";
                            clicked => {
                                if root.upd-state == "available" || root.upd-state == "ready" {
                                    root.do-update();
                                } else {
                                    root.check-update();
                                }
                            }
                        }
                    }
                }
                Row {
                    label: "自动更新（启动时和每 6 小时检查，空闲时自动安装）";
                    last: true;
                    VerticalLayout { alignment: center; Switch { on: root.auto-update; toggled => { root.toggle-auto-update(); } } }
                }
            }
            Section {
                title: "关于";
                VerticalLayout {
                    padding-top: 4px;
                    // Linux：两个 p 的 4px 外边距折叠成一个（下一段自己带 4）
                    padding-bottom: Fx.gtk ? 0px : 4px;
                    Text { height: Fx.gtk ? Fx.lb(12px, self.text, 0px) : self.preferred-height; vertical-alignment: center; text: "Lancat " + root.me-ver + " · " + root.me-os + " · 局域网零配置快传"; font-size: 12px; color: Theme.text; wrap: word-wrap; }
                }
                FlowNote {
                    toks: root.about-toks;
                    lines: root.about-lines;
                    measured(i, w) => { root.about-measured(i, w); }
                    width-changed(w) => { root.about-width(w); }
                }
            }
        }
        }
    }
    }
    sb := ScrollBar {
        x: parent.width - self.width;
        y: root.csd-h;
        height: parent.height - root.csd-h;
        view-h: fl.height;
        content-h: fl.content-height;
        pos <=> fl.content-y;
        // 设置页是根文档滚动：WebView2 里 :hover 覆盖整页（指针在窗口内就显示滑块），
        // WebKitGTK 只有指针压在滚动条上才算（实测），所以 Linux 只看滚动条自身
        hovered: (Fx.gtk ? false : hov.has-hover) || self.hov;
    }
    if root.csd: CsdBar {
        x: 0;
        y: 0;
        width: parent.width;
        title: root.title;
        maximized: root.csd-maximized;
        act(a, x, y) => { root.csd-act(a, x, y); }
    }
    TipBubble {
        win-w: root.width;
        win-h: root.height;
    }
}
