<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 网络与发现 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- mDNS / UDP 广播发现：没有组播锁时很多机型会丢掉发给本机的组播包；同时也是 connectedDevice 前台服务的前置条件之一 -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- targetSdk=37：Android 17 起访问局域网（TCP 出入、UDP 单播/组播/广播、mDNS）必须获得这个运行时权限（NEARBY_DEVICES 组），
         MainActivity 启动时由 Permissions.kt 申请；Android 16 及以下不存在该权限，声明无副作用 -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- 前台服务：传输用 dataSync（Android 15 起每 24 小时共 6 小时），常驻接收用 connectedDevice（无时长上限、可从开机广播启动） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- 通知 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 16 Live Updates（升级为常驻推广通知）；非运行时权限 -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

    <!-- 应用内更新：下载 GitHub 发布的 APK 后交给系统安装器（用户在系统界面确认） -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Android 8–9 写 Download/Lancat 需要；10 起用 MediaStore，不需要存储权限 -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"
        tools:ignore="ScopedStorage" />

    <application
        android:name=".LancatApplication"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_app_v2"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_app_v2_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Lancat"
        tools:targetApi="36">

        <!-- 单 Activity。通知、快捷方式点进来带 fan.lancat.extra.PEER_ID -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- 系统分享菜单 + Direct Share 入口：半屏选设备；从 Direct Share 进来直接发送不显示界面 -->
        <activity
            android:name=".share.ShareActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/share_label"
            android:launchMode="standard"
            android:taskAffinity="fan.lancat.share"
            android:theme="@style/Theme.Lancat.Share"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <!-- API 26–28：androidx.sharetarget 用 ChooserTargetService 兼容层把动态快捷方式提供给分享面板 -->
            <meta-data
                android:name="android.service.chooser.chooser_target_service"
                android:value="androidx.sharetarget.ChooserTargetServiceCompat" />
        </activity>

        <!-- 通知「打开」「在文件夹中显示」、Tile 兜底启动服务：无界面跳板（Android 12 起不能从广播里开 Activity） -->
        <activity
            android:name=".notify.OpenFileActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Lancat.Invisible" />

        <service
            android:name=".service.LancatService"
            android:exported="false"
            android:foregroundServiceType="dataSync|connectedDevice" />

        <service
            android:name=".tile.ReceiveTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <receiver
            android:name=".notify.NotificationActionReceiver"
            android:exported="false" />

        <!-- 默认禁用；只有常驻开关打开时才由 SysPrefs 启用，关掉常驻后开机不会再拉起 -->
        <receiver
            android:name=".service.BootReceiver"
            android:enabled="false"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
